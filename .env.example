# ---------------------------------------------------------------------------
# The Dragons' Den - local configuration template.
# Copy to .env and fill in. NEVER commit real values: .env is git-ignored.
# In Cloud Run, secrets are injected from Secret Manager (see terraform/).
# ---------------------------------------------------------------------------

# Option A - Vertex AI (recommended; uses ADC, no API key needed)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Option B - Gemini API key: do NOT paste it here for shared environments; store it in
# Secret Manager as "dragons-den-gemini-api-key" and the app will fetch it at startup.
# GOOGLE_API_KEY=

# Strategic model routing
DEN_FAST_MODEL=gemini-2.5-flash
DEN_DEEP_MODEL=gemini-2.5-pro
DEN_MAX_REVIEW_LOOPS=3

# Persistence
SESSION_DB_URL=sqlite+aiosqlite:///./.den_sessions.db
DECISION_STORE_BACKEND=sqlite          # or: firestore
DECISION_STORE_PATH=./.den_decisions.db
# AGENT_ENGINE_ID=                     # enables VertexAiSessionService + Memory Bank

# Guardrails & observability
ENABLE_CLOUD_DLP=false
ENABLE_MODEL_ARMOR=false
# MODEL_ARMOR_TEMPLATE=projects/<project>/locations/us-central1/templates/dragons-den
ENABLE_CLOUD_TRACE=false
OTEL_CONSOLE_EXPORT=false
LOG_LEVEL=INFO
